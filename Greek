<key c="7" s="&amp;" n="-" nw="_" />
<key c="8" s="*" n="+" />
<key c="9" s="(" n="=" />
<key c="0" s=")" n="•" />
</row>

<row>
<key c="accent_aigu" nw="esc" ne="`" se="superscript" />
<key c="accent_trema" se="subscript" />
<key c="ε" />
<key c="ρ" />
<key c="τ" />
<key c="θ" />
<key c="ου" />
<key c="ι" sw="{" se="}" nw="η" ne="υ" />
<key c="ο" se="ω" />
<key c="π" sw="?" />
</row>

<row>
<key c="α" shift="0.2" width="1.2" />
